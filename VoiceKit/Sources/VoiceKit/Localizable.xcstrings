{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ Using the built-in voice instead." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 改用内置语音。"
          }
        }
      }
    },
    "Add an OpenAI API key in Settings to use OpenAI voices. Using the built-in voice." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用 OpenAI 语音，请在设置中添加 OpenAI API 密钥。现在使用内置语音。"
          }
        }
      }
    },
    "Ask about the photo, or tap the orb" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就照片提问，或轻点圆球"
          }
        }
      }
    },
    "Attached photo" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附带的照片"
          }
        }
      }
    },
    "Camera access is off. Turn it on in Settings › Privacy & Security › Camera." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机权限已关闭。请在“设置”›“隐私与安全性”›“相机”中打开。"
          }
        }
      }
    },
    "Camera preview" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机预览"
