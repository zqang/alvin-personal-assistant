    "The microphone isn't available." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风不可用。"
          }
        }
      }
    },
    "The model declined to answer this. Try rephrasing." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型拒绝回答这个问题。请换个说法再试。"
          }
        }
      }
    },
    "The photo couldn't be read on this iPhone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
