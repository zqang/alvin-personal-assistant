    "Speaking" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在说话"
          }
        }
      }
    },
    "Speech recognition for %@ isn't available right now. Check your connection or pick another language in Settings." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法使用 %@ 的语音识别。请检查网络连接，或在设置中选择其他语言。"
          }
        }
      }
    },
    "Speech recognition is off. Turn it on in Settings › Privacy & Security › Speech Recognition." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音识别已关闭。请在“设置”›“隐私与安全性”›“语音识别”中打开。"
          }
        }
      }
    },
    "Speech recognition isn't available right now." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法使用语音识别。"
          }
        }
      }
    },
    "Speech recognition isn't available right now. Check your internet connection, or pick a language in Settings that your iPhone can recognize offline." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法使用语音识别。请检查网络连接，或在设置中选择 iPhone 可以离线识别的语言。"
          }
        }
      }
    },
    "Standard" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标准"
