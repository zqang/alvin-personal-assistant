    "Think deeper" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深入思考"
          }
        }
      }
    },
    "Thinking…" : {
      "comment" : "Its English entry gives the built bundle an en.lproj, so an app's English setting wins over a Chinese iPhone (Bundle.voiceKitStrings).",
